# LLM API Keys
GEMINI_API_KEY=example
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=example
GROQ_MODEL=qwen/qwen3.8-27b
USE_GROQ_PRIMARY=true

GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768


# MongoDB Atlas (Vector Store & Knowledge Base)
MONGODB_URI=example
MONGODB_DB_NAME=SC2026


# Qdrant Vector Store (Dense + Sparse Hybrid Search)
QDRANT_URL=example
QDRANT_API_KEY=example
BGE_M3_DEVICE=cpu
GEMINI_EMBEDDING_TIMEOUT=120


# Application Environment
ENV=development
HOST=0.0.0.0
PORT=8000


# HuggingFace
HF_TOKEN=example
HF_RERANKER_API_URL=example
HF_RERANKER_TIMEOUT=30


# Supabase
SUPABASE_DATABASE_URL=example
SUPABASE_URL=example
SUPABASE_KEY=example
SUPABASE_URL=example

# LangChain
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=example
LANGCHAIN_PROJECT=customer-agent-demo
