# Gemini API key. Không commit file .env thật.
GEMINI_API_KEY=your_gemini_api_key_here

# Model dùng cho data_gen production run.
HARNESS_GEN_MODEL=gemini-3.5-flash-lite

# Khoảng nghỉ tối thiểu giữa hai request Gemini (giây).
GEMINI_MIN_INTERVAL_SECONDS=2.0

# BTC data directory (tùy chọn; mặc định là ./data).
BTC_DIR=./data

# Các biến legacy dùng bởi langgraph_agent nếu chạy agent hiện tại.
# Không cần cho data_gen dry-run; giữ lại để không phá setup của agent.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HARNESS_MODEL=claude-sonnet-4-6
HARNESS_DB=harness_memory.db
