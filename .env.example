# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas (Document Store & Knowledge Base)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=SC2026

# Qdrant Vector Store (Dense + Sparse Hybrid Search)
# Tuỳ chọn 1: Dùng Qdrant Cloud hoặc Server Docker
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Tuỳ chọn 2: Lưu trực tiếp trên ổ đĩa local (không cần server Docker)
# QDRANT_PATH=data/qdrant_storage

# Embedding Model (BGE-M3)
BGE_M3_DEVICE=cpu   # cpu hoặc cuda

# Application Environment
ENV=development
PORT=8000
