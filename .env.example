# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GENERATOR_MAX_TOKENS=1000

# MongoDB Atlas (Document Store & Knowledge Base)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=SC2026

# Qdrant Cloud (Dense + Sparse Hybrid Search)
QDRANT_URL=https://<your-cluster>.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key
# Không đặt QDRANT_PATH khi dùng Qdrant Cloud.

# Embedding Model (BGE-M3)
BGE_M3_DEVICE=cpu   # cpu hoặc cuda
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
# Hugging Face Inference API reranker
HF_TOKEN=your_huggingface_token
HF_RERANKER_API_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-reranker-v2-m3
HF_RERANKER_TIMEOUT=30

# Application Environment
ENV=development
HOST=0.0.0.0
PORT=8000
# Chỉ bật khi chạy development bằng `python -m src.api.main`.
UVICORN_RELOAD=false
