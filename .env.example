# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GENERATOR_MAX_TOKENS=2048

# MongoDB Atlas (Document Store & Knowledge Base)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=SC2026

# Qdrant Cloud (Dense + Sparse Hybrid Search)
QDRANT_URL=https://<your-cluster>.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key
# Do not set QDRANT_PATH when using Qdrant Cloud.

# Embedding Model (BGE-M3)
BGE_M3_DEVICE=cpu   # cpu or cuda
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_TIMEOUT=60
# Local reranker model (downloaded from Hugging Face on first use)
HF_RERANKER_MODEL=BAAI/bge-reranker-base

# Application Environment
ENV=development
HOST=0.0.0.0
PORT=8000
# Enable only when running the development server with `python -m src.api.main`.
UVICORN_RELOAD=false

# Graph session/profile memory (Supabase PostgreSQL + Qdrant Cloud)
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
